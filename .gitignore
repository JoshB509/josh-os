# Sign-ins, keys and personal data (never commit)
Data/
**/browser-profile/
**/key-cache/
.env
.env.*
!.env.example
*.key
*.pem

# Large working folders
Runs/
Engines/
Backups/
Evidence/
References/

# Binaries and build output
tools/
*.exe
build/
dist/
__pycache__/
*.pyc
*.log

# Local machine settings (copy settings.example.json to settings.json)
settings.json

# Decoded audio caches
*.f32

# Local settings backups made before risky changes (machine-specific, like settings.json)
settings.*.json
!settings.example.json

# Temporary folders some tests leave behind
tests/tmp*/
